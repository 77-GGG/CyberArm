\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeCaseStudy}[2026/09/18 Minimal architectural case-study beamer theme]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{beamerthemeCaseStudy}{Please compile with XeLaTeX}{This theme uses fontspec and xeCJK.}
\fi

\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{xparse}
\RequirePackage{ragged2e}
\usetikzlibrary{calc}

% -----------------------------------------------------------------------------
% 1. Typography
%    The reference PDF uses Calibri + Microsoft YaHei / DengXian.
%    Noto Sans / Noto Sans CJK SC are used here for portability and a similar
%    clean neutral tone. Swap the two lines below to Calibri / Microsoft YaHei
%    on a machine where those fonts are installed.
% -----------------------------------------------------------------------------
\IfFontExistsTF{Noto Sans}
  {\setsansfont{Noto Sans}\setmainfont{Noto Sans}}
  {\setsansfont{Latin Modern Sans}\setmainfont{Latin Modern Sans}}
\IfFontExistsTF{Noto Sans CJK SC}
  {\setCJKsansfont{Noto Sans CJK SC}\setCJKmainfont{Noto Sans CJK SC}}
  {\setCJKsansfont{FandolHei-Regular}\setCJKmainfont{FandolHei-Regular}}
\renewcommand{\familydefault}{\sfdefault}

% -----------------------------------------------------------------------------
% 2. Palette and global beamer cleanup
% -----------------------------------------------------------------------------
\definecolor{CaseRed}{HTML}{E44332}
\definecolor{CaseText}{HTML}{161616}
\definecolor{CaseGray}{HTML}{777777}
\definecolor{CaseLightGray}{HTML}{EAEAEA}
\definecolor{CasePaper}{HTML}{FFFFFF}

\setbeamercolor{normal text}{fg=CaseText,bg=CasePaper}
\setbeamercolor{structure}{fg=CaseRed}
\setbeamercolor{frametitle}{fg=CaseText,bg=CasePaper}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}
\setbeamersize{text margin left=0cm,text margin right=0cm}
\setlength{\parindent}{0pt}

% -----------------------------------------------------------------------------
% 3. Core philosophy
%    - 16:9 white field
%    - tiny upper-left identification block
%    - one dominant image + one/two supporting drawings or photos
%    - no shadows, no borders, no decorative bands
%    - whitespace is an active layout element
% -----------------------------------------------------------------------------

% Place arbitrary content using a top-left origin.
% Usage: \CasePlace{0.45cm}{1.45cm}{...}
\NewDocumentCommand{\CasePlace}{m m +m}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at
      ([xshift=#1,yshift=-#2]current page.north west) {#3};
  \end{tikzpicture}%
}

% Standard two-line identification block used on nearly every slide.
% #1 = Chinese/project title
% #2 = red author/architect/studio name
% #3 = black continuation, usually English project name + year
\NewDocumentCommand{\CaseHeader}{m m m}{%
  \CasePlace{0.48cm}{0.27cm}{%
    \begin{minipage}{15.0cm}
      \RaggedRight
      {\fontsize{7.4}{8.6}\selectfont #1\par}
      \vspace{0.03cm}
      {\fontsize{5.7}{6.6}\selectfont
       \textcolor{CaseRed}{#2}\textcolor{CaseText}{#3}\par}
    \end{minipage}%
  }%
}

% Optional third line below the header.
\NewDocumentCommand{\CaseSubline}{m}{%
  \CasePlace{0.48cm}{0.77cm}{%
    \begin{minipage}{12.5cm}
      {\fontsize{5.2}{6.2}\selectfont\textcolor{CaseText}{#1}}%
    \end{minipage}%
  }%
}

% Tiny label/caption for maps, diagrams, keywords, etc.
% #1 x, #2 y, #3 width, #4 text
\NewDocumentCommand{\CaseNote}{m m m m}{%
  \CasePlace{#1}{#2}{%
    \begin{minipage}{#3}
      \RaggedRight
      {\fontsize{5.0}{6.1}\selectfont\textcolor{CaseGray}{#4}}%
    \end{minipage}%
  }%
}

% Image placement by width, preserving aspect ratio.
% #1 x, #2 y, #3 width, #4 file
\NewDocumentCommand{\CaseImage}{m m m m}{%
  \CasePlace{#1}{#2}{\includegraphics[width=#3]{#4}}%
}

% Image placement by height, preserving aspect ratio.
\NewDocumentCommand{\CaseImageH}{m m m m}{%
  \CasePlace{#1}{#2}{\includegraphics[height=#3]{#4}}%
}

% Lightened line drawing / contextual figure.
% #1 x, #2 y, #3 width, #4 opacity 0..1, #5 file
\NewDocumentCommand{\CaseDrawing}{m m m m m}{%
  \CasePlace{#1}{#2}{%
    \begin{tikzpicture}
      \node[inner sep=0pt,opacity=#4]{\includegraphics[width=#3]{#5}};
    \end{tikzpicture}%
  }%
}

% Minimal text block. Keep short: the reference deck is image-led.
\NewDocumentCommand{\CaseTextBlock}{m m m m}{%
  \CasePlace{#1}{#2}{%
    \begin{minipage}{#3}
      \RaggedRight
      {\fontsize{6.0}{7.7}\selectfont #4}%
    \end{minipage}%
  }%
}

% A small red keyword, matching the restrained use of red in the reference PDF.
\NewDocumentCommand{\CaseKeyword}{m m m}{%
  \CasePlace{#1}{#2}{%
    {\fontsize{5.8}{6.5}\selectfont\color{CaseRed}\bfseries #3}%
  }%
}

% Standard content frame. The body is collected explicitly because Beamer's
% frame environment performs its own body scanning.
\NewDocumentEnvironment{caseframe}{m m m +b}{%
  \begin{frame}[plain]
    \CaseHeader{#1}{#2}{#3}%
    #4
  \end{frame}%
}{}

% -----------------------------------------------------------------------------
% 4. Title slide
% -----------------------------------------------------------------------------
% #1 red main title; #2 black subtitle; #3 studio/course line; #4 school line;
% #5 professor line; #6 TA line; #7 date/version line
\NewDocumentCommand{\CaseTitleSlide}{m m m m m m m}{%
  \begin{frame}[plain]
    \CasePlace{3.00cm}{0.35cm}{%
      \begin{minipage}{7.3cm}
        {\fontsize{14.5}{16.0}\selectfont\color{CaseRed}#1\par}
        \vspace{0.05cm}
        {\fontsize{12.8}{14.0}\selectfont\color{CaseText}#2\par}
      \end{minipage}%
    }
    \CasePlace{1.45cm}{6.92cm}{%
      \begin{minipage}{3.55cm}
        \raggedleft
        {\fontsize{6.9}{8.1}\selectfont
         #3\par
         \textit{#4}\par
         \textit{#5}\par
         \textit{#6}\par
         #7\par}
      \end{minipage}%
    }
  \end{frame}%
}

% -----------------------------------------------------------------------------
% 5. Minimal section marker
% -----------------------------------------------------------------------------
\NewDocumentCommand{\CaseSectionSlide}{m m}{%
  \begin{frame}[plain]
    \CasePlace{3.00cm}{0.48cm}{%
      \begin{minipage}{9.5cm}
        {\fontsize{13.2}{15.0}\selectfont\color{CaseRed}#1\par}
        \vspace{0.05cm}
        {\fontsize{8.8}{10.2}\selectfont\color{CaseText}#2\par}
      \end{minipage}%
    }
  \end{frame}%
}

% -----------------------------------------------------------------------------
% 6. Ready-made layout recipes (optional)
% -----------------------------------------------------------------------------
% Right hero + small left image, close to the most common page type.
\NewDocumentCommand{\CaseLayoutHeroRight}{m m}{%
  \CaseImage{0.38cm}{1.50cm}{4.55cm}{#1}%
  \CaseImage{5.85cm}{1.50cm}{9.65cm}{#2}%
}

% Left drawing + large right photo.
\NewDocumentCommand{\CaseLayoutPlanPhoto}{m m}{%
  \CaseImage{0.62cm}{2.10cm}{4.10cm}{#1}%
  \CaseImage{5.78cm}{1.42cm}{9.68cm}{#2}%
}

% Wide technical drawing on top + two visual fields below.
\NewDocumentCommand{\CaseLayoutSectionCollage}{m m m}{%
  \CaseImage{5.85cm}{1.20cm}{8.80cm}{#1}%
  \CaseImage{0.55cm}{4.15cm}{4.55cm}{#2}%
  \CaseImage{5.85cm}{4.15cm}{7.20cm}{#3}%
}

